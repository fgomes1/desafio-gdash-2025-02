# Database
MONGODB_URI=mongodb://admin:password123@localhost:27017/weather_db?authSource=admin

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Default Admin User (created automatically on first run)
DEFAULT_ADMIN_NAME=Admin GDASH
DEFAULT_ADMIN_EMAIL=admin@gdash.com
DEFAULT_ADMIN_PASSWORD=admin123

# Application
PORT=3000
NODE_ENV=development
